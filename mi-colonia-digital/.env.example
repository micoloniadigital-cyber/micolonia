# ============================================================
# Mi Colonia Digital — variables de entorno (archivo .env.example)
# En Vercel: Settings → Environment Variables, pega cada nombre
# con su valor ANTES de apretar Deploy.
# ============================================================

# Dirección de tu proyecto de Supabase (Project URL).
# En Supabase: Settings → API, hasta arriba dice «Project URL».
# Esta SÍ puede ser pública.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave PUBLICABLE de Supabase (la de arriba en «Claves API»,
# empieza con sb_publishable_). Es segura en el navegador
# porque las tablas tienen seguridad a nivel de fila (RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_pega-aqui-tu-clave-publicable

# Clave SECRETA de Supabase (la de la sección «Claves secretas»,
# la de abajo en tu pantalla de Supabase). SOLO va en el servidor.
# NUNCA la pongas en el navegador, en GitHub ni en un chat.
# Aquí va solo el marcador: el valor real lo pegas directamente
# en las variables de Vercel, nunca en este archivo si el
# repositorio es público.
SUPABASE_SECRET_KEY=pega-aqui-tu-clave-secreta-nunca-en-el-navegador

# Dirección pública de la plataforma.
NEXT_PUBLIC_SITE_URL=https://micoloniadigital.com

# Correo del administrador (Mario).
ADMIN_EMAIL=micoloniadigital@gmail.com

# Contraseña del administrador. SOLO va en el servidor (variables
# de Vercel), nunca en GitHub ni en un chat: aquí va solo el
# marcador, el valor real lo escribes directo en Vercel.
ADMIN_PASSWORD=pon-aqui-tu-contrasena-de-admin-solo-en-vercel
